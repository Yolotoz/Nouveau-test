# Token du bot (Discord Developer Portal → ton application → Bot → Reset Token)
DISCORD_TOKEN=
# Identifiant de l'application (Developer Portal → General Information → Application ID)
CLIENT_ID=
# Optionnel : identifiant de ton serveur de test, pour que les commandes apparaissent tout de suite
GUILD_ID=
# Fuseau horaire utilisé pour lire les heures tapées par les joueurs
TIMEZONE=Europe/Paris
